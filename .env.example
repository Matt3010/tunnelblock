# Copy to .env and replace every required value. Never commit .env.
HOST_REPO_DIR=/absolute/path/to/tunnelblock
WG_SERVER_ENDPOINT=auto
ADMIN_API_TOKEN=replace-with-a-long-random-secret
# Web panel login (HTTP Basic auth). Password: at least 12 characters.
WEB_USER=admin
WEB_PASSWORD=replace-with-a-long-passphrase
# WEB_PORT=8088
GITHUB_TOKEN=replace-with-a-fine-grained-token-that-can-read-this-repository
