connections {
  ios-adblock {
    version = 2
    local_addrs = 0.0.0.0

    local {
      auth = pubkey
      certs = server-cert.pem
      id = adblock.scanferlamatteo.work
    }

    remote {
      auth = eap-mschapv2
      eap_id = %any
    }

    children {
      ios-adblock {
        local_ts = 0.0.0.0/0, ::/0
        esp_proposals = aes256gcm16-prfsha256-ecp256
      }
    }

    pools = ios-pool
    proposals = aes256-sha256-ecp256
    send_cert = always
  }
}

pools {
  ios-pool {
    addrs = 10.42.0.0/24
    dns = 10.42.0.1
  }
}

secrets {
  eap-user {
    id = adblock
    secret = CHANGE_ME
  }
}
